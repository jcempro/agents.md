{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agents-normative-index/v1",
  "title": "Índice normativo da Norma Operacional",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "id", "version", "generated", "authority", "root", "nodes", "edges", "fallback"],
  "properties": {
    "schema": { "const": "agents-normative-index/v1" },
    "id": { "type": "string", "minLength": 1 },
    "version": { "type": "integer", "minimum": 1 },
    "generated": { "type": "boolean" },
    "authority": { "type": "string", "minLength": 1 },
    "root": { "type": "string", "minLength": 1 },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "path", "class", "type", "roles", "triggers", "inputs", "outputs"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]+$" },
          "path": { "type": "string", "pattern": "^(AGENTS|INIT-REPO|\\.ia\\.rules/[A-Za-z0-9._/-]+)\\.md$" },
          "class": { "enum": ["core", "role", "scenario", "capability", "resource", "meta", "bootstrap", "evaluation"] },
          "type": { "enum": ["leaf", "derivation", "hybrid"] },
          "roles": { "type": "array", "items": { "enum": ["common", "final", "constructor"] }, "minItems": 1, "uniqueItems": true },
          "triggers": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1, "uniqueItems": true },
          "inputs": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
          "outputs": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
          ,
          "bytes": { "type": "integer", "minimum": 0 },
          "guard": { "type": "object" },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "tokens": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["from", "to", "mode", "condition", "order"],
        "properties": {
          "from": { "type": "string", "minLength": 1 },
          "to": { "type": "string", "minLength": 1 },
          "mode": { "enum": ["immediate", "passive"] },
          "condition": { "type": "string", "minLength": 1 },
          "order": { "type": "integer", "minimum": 1 }
          ,
          "at": { "type": "string", "minLength": 1 }
        }
      }
    },
    "fallback": {
      "type": "object",
      "additionalProperties": false,
      "required": ["on", "action"],
      "properties": {
        "on": { "type": "array", "items": { "type": "string" }, "minItems": 1, "uniqueItems": true },
        "action": { "const": "read-all-normative-nodes-by-precedence" }
      }
    },
    "generation": { "type": "object" },
    "metrics": { "type": "object" },
    "paths": { "type": "array" }
  }
}
