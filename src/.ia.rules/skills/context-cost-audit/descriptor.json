{
  "schema": "agents-skill-descriptor/v1",
  "name": "context-cost-audit",
  "description": "Audita custo contextual end-to-end e combinações sem perder átomos ou relações materiais.",
  "version": "1.0.0",
  "purpose": "Medir rotas, estado, memória, recovery e resume com equivalência verificável.",
  "positiveTriggers": ["auditar custo contextual", "comparar tokens por rota", "otimizar contexto sem perda"],
  "negativeTriggers": ["contar tokens de um arquivo", "otimizar runtime do modelo", "resumir texto informal"],
  "roles": ["final", "constructor"],
  "authority": "AGENTS.md, RCF e decisões recusadas permanecem superiores",
  "inputs": {"required": ["experiment.json"], "optional": ["report.json", "report.md"]},
  "output": {"format": "relatório reproduzível JSON e Markdown"},
  "requires": [".ia.rules/resources/context-cost-audit.md", ".ia.rules/state/decisions/refused/index.json"],
  "resources": ["references/experiment-contract.md"],
  "scripts": ["scripts/context_cost_audit.py"],
  "hooks": [],
  "permissions": ["leitura do corpus", "escrita somente do relatório autorizado"],
  "effects": ["relatório experimental local", "nenhuma otimização aplicada"],
  "limits": {"routingDepth": 1, "requiresExactAtomEquivalence": true, "appliesRecommendation": false},
  "validation": ["descoberta positiva e negativa", "tokenizer declarado", "átomos e relações integrais", "isolados e combinações", "reprodutibilidade"],
  "origin": "jcempro/agents.md",
  "license": "MPL-2.0",
  "trust": "first-party-reviewed",
  "clients": ["codex", "github-copilot"],
  "precedence": "subordinada a AGENTS.md, RCF e decisões recusadas",
  "merge": "instalação por arquivo gerenciado sem sobrescrever conteúdo não gerenciado",
  "update": "transacional por hash",
  "removal": "somente arquivo gerenciado e com aprovação"
}
