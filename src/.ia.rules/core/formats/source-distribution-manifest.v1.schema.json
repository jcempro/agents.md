{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agents-source-distribution/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "id", "version", "generated", "authority", "scope", "profiles", "entries", "integrity"],
  "properties": {
    "schema": { "const": "agents-source-distribution/v1" },
    "id": { "const": "agents.source-distribution" },
    "version": { "const": 1 },
    "generated": { "const": false },
    "authority": { "type": "string", "minLength": 1 },
    "scope": { "const": "src" },
    "profiles": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": ["consumer-core", "consumer-runtime", "consumer-scenario", "consumer-bootstrap", "generated-release"]
      }
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "profile", "destination", "purpose", "roles", "condition", "ownership", "validation"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "profile": {
            "enum": ["consumer-core", "consumer-runtime", "consumer-scenario", "consumer-bootstrap", "generated-release"]
          },
          "destination": { "type": "string", "minLength": 1 },
          "purpose": { "type": "string", "minLength": 1 },
          "roles": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "enum": ["common", "final", "constructor"] }
          },
          "condition": { "type": "string", "minLength": 1 },
          "ownership": { "const": "managed" },
          "language": {
            "enum": ["typescript"]
          },
          "artifact": {
            "type": "object",
            "additionalProperties": false,
            "required": ["destination", "format", "target", "builder"],
            "properties": {
              "destination": { "type": "string", "minLength": 1 },
              "format": { "const": "commonjs" },
              "target": { "const": "node24" },
              "builder": { "type": "string", "minLength": 1 }
            }
          },
          "validation": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "timing"],
      "properties": {
        "algorithm": { "const": "sha256" },
        "timing": { "const": "build" }
      }
    }
  }
}
