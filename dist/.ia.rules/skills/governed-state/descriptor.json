{
  "schema": "agents-skill-descriptor/v1",
  "name": "governed-state",
  "description": "Roteia execução e retomada de TODO governado sem misturar demanda, FT, norma e autorização.",
  "version": "1.0.0",
  "purpose": "Executar estado e TODO governados com divulgação seletiva e preservação.",
  "positiveTriggers": ["executar TODO.ia.md", "continuar FT", "migrar estado canônico"],
  "negativeTriggers": ["lista informal", "lembrete pessoal", "planejamento sem TODO.ia.md"],
  "roles": ["final", "constructor"],
  "authority": "AGENTS.md e RCF permanecem superiores",
  "inputs": {"required": ["repositoryRoot"], "optional": ["ft", "authorization"]},
  "output": {"format": "estado resumível com evidência"},
  "requires": [".ia.rules/state/index.json quando existente"],
  "resources": [],
  "scripts": [".ia.rules/core/runtime/scripts/state-manager.js"],
  "hooks": [],
  "permissions": ["leitura do repositório", "escrita somente quando autorizada"],
  "effects": ["atualização explícita de estado"],
  "limits": {"routingDepth": 1, "implicitAuthority": false},
  "validation": ["gatilhos positivos e negativos", "Equalizer perene", "gate normativo"],
  "origin": "jcempro/agents.md",
  "license": "MPL-2.0",
  "trust": "first-party-reviewed",
  "clients": ["codex", "github-copilot"],
  "precedence": "subordinada a AGENTS.md e RCF",
  "merge": "instalação por arquivo gerenciado sem sobrescrever conteúdo não gerenciado",
  "update": "transacional por hash",
  "removal": "somente arquivo gerenciado e com aprovação"
}
