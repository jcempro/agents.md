{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agents-rcf-trace/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "schema", "entries"],
  "properties": {
    "format": { "const": "agents-rcf-trace/v1" },
    "schema": { "const": 1 },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["artifacts", "commit", "ft", "id", "line", "rcf", "sentenceSha256", "state", "syncCommit"],
        "properties": {
          "artifacts": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
          "commit": { "type": "string", "pattern": "^(?:|[a-f0-9]{40})$" },
          "ft": { "type": "string" },
          "id": { "type": "string", "pattern": "^[a-f0-9]{24}$" },
          "line": { "type": "integer", "minimum": 1 },
          "rcf": { "type": "string", "minLength": 1 },
          "sentenceSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "state": { "enum": ["pending", "materialized", "synchronized"] },
          "syncCommit": { "type": "string", "pattern": "^(?:|[a-f0-9]{40})$" }
        }
      }
    }
  }
}
