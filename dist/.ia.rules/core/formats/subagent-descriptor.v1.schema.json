{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agents-subagent-descriptor/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "id", "description", "version", "objective", "positiveTriggers", "negativeTriggers", "roles", "authority", "tools", "permissions", "read", "write", "inputs", "output", "budget", "timeout", "cancellation", "returnToPrimary", "requires", "concurrency", "stopConditions", "states", "effects", "validation", "origin", "license", "trust", "clients", "precedence", "update", "removal"],
  "properties": {
    "schema": { "const": "agents-subagent-descriptor/v1" },
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$" },
    "description": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "objective": { "type": "string", "minLength": 1 },
    "positiveTriggers": { "$ref": "#/$defs/strings" },
    "negativeTriggers": { "$ref": "#/$defs/strings" },
    "roles": { "$ref": "#/$defs/strings" },
    "authority": { "type": "string", "minLength": 1 },
    "tools": { "$ref": "#/$defs/strings" },
    "permissions": { "$ref": "#/$defs/strings" },
    "read": { "$ref": "#/$defs/strings" },
    "write": { "$ref": "#/$defs/strings" },
    "inputs": { "type": "object" },
    "output": { "type": "object" },
    "budget": { "type": "object" },
    "timeout": { "type": "object" },
    "cancellation": { "type": "object" },
    "returnToPrimary": { "type": "object" },
    "requires": { "$ref": "#/$defs/strings" },
    "concurrency": { "type": "object" },
    "stopConditions": { "$ref": "#/$defs/strings" },
    "states": { "$ref": "#/$defs/strings" },
    "effects": { "$ref": "#/$defs/strings" },
    "validation": { "$ref": "#/$defs/strings" },
    "origin": { "type": "string", "minLength": 1 },
    "license": { "type": "string", "minLength": 1 },
    "trust": { "type": "string", "minLength": 1 },
    "clients": { "$ref": "#/$defs/strings" },
    "precedence": { "type": "string", "minLength": 1 },
    "update": { "type": "string", "minLength": 1 },
    "removal": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "strings": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
  }
}
