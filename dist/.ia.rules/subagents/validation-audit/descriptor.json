{
  "schema": "agents-subagent-descriptor/v1",
  "id": "validation-audit",
  "description": "Auditoria independente e somente leitura de gates, regressões e evidências.",
  "version": "1.0.0",
  "objective": "Executar validações isoláveis e devolver achados compactos ao agente primário.",
  "positiveTriggers": ["auditoria independente", "gates longos paralelizáveis", "revisão de regressão"],
  "negativeTriggers": ["edição sequencial pequena", "decisão que exige síntese global", "ausência de isolamento"],
  "roles": ["final", "constructor"],
  "authority": "somente evidência; agente primário conserva decisão e comunicação",
  "tools": ["read", "search", "execute"],
  "permissions": ["read-only", "sem rede por padrão"],
  "read": ["repositório corrente"],
  "write": [],
  "inputs": {"required": ["objetivo", "comandos permitidos"], "optional": ["baseline"]},
  "output": {"required": ["status", "evidências", "achados", "comandos"]},
  "budget": {"maxConcurrent": 1, "compactReturn": true},
  "timeout": {"source": "histórico observado", "defaultSeconds": 900, "marginPercent": 50},
  "cancellation": {"propagate": true, "cleanup": true},
  "returnToPrimary": {"always": true, "format": "compact-evidence"},
  "requires": ["subtarefa isolável", "ganho paralelo"],
  "concurrency": {"allowed": true, "duplicateMonitoring": false},
  "stopConditions": ["objetivo comprovado", "timeout", "cancelamento", "autoridade insuficiente"],
  "states": ["queued", "running", "completed", "failed", "timed_out", "cancelled"],
  "effects": ["nenhuma alteração de produto"],
  "validation": ["least privilege", "timeout", "retorno", "parada"],
  "origin": "jcempro/agents.md",
  "license": "MPL-2.0",
  "trust": "first-party-reviewed",
  "clients": ["codex", "github-copilot"],
  "precedence": "subordinado ao agente primário",
  "update": "transacional por hash",
  "removal": "somente adaptador gerenciado e com aprovação"
}
